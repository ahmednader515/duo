    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "@aws-sdk/client-s3": "3.1169.0",
    "bcryptjs": "3.0.3",
    "zod": "4.6.7",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "sonner": "2.0.8",
    "server-only": "0.0.1",
    "dotenv": "18.0.10"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15"
  }
